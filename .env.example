# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=etb
NEXT_PUBLIC_PAYMENT_MODE=CHAPA
NEXT_PUBLIC_MANUAL_BANK_DETAILS="Commercial Bank of Ethiopia\nAccount: 1000XXXXXXXXX\nName: Creator Name"

# Stripe fallback checkout
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Chapa / TeleBirr payment verification webhook
CHAPA_SECRET_KEY=CHASECK_replace_me
CHAPA_WEBHOOK_SECRET=replace_me

# Contact + order email delivery. Use either Formspree for contact or Resend for contact/order admin mail.
FORMSPREE_ENDPOINT=https://formspree.io/f/replace_me
RESEND_API_KEY=re_replace_me
CONTACT_TO_EMAIL=studio@example.com

# Protected live upload panel
ADMIN_UPLOAD_PASSWORD=replace-with-a-long-random-password

# Supabase live data + order persistence
# Both SUPABASE_URL and NEXT_PUBLIC_SUPABASE_URL are supported.
SUPABASE_URL=https://replace-me.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://replace-me.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_ARCHIVE_BUCKET=archive
SUPABASE_RECEIPTS_BUCKET=receipts
